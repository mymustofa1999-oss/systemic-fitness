# ═══════════════════════════════════════════
#  FitCoach API — Environment Variables
# ═══════════════════════════════════════════

# Server
PORT=8080
ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://fitcoach:fitcoach@localhost:5432/fitcoach?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_ACCESS_EXPIRY=720h
JWT_REFRESH_EXPIRY=720h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Bcrypt
BCRYPT_COST=12

# File Upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:8080

# Midtrans (payment gateway, optional — leave empty to use only manual transfer)
# Server key dari Midtrans dashboard. Format sandbox: SB-Mid-server-XXXXXXXX
MIDTRANS_SERVER_KEY=
# Client key dipakai mobile/web saja, server tidak mensign apapun dengannya
MIDTRANS_CLIENT_KEY=
# sandbox | production
MIDTRANS_ENV=sandbox
# Webhook URL yang dipanggil Midtrans saat status transaksi berubah.
# Contoh produksi: https://api.fitcoach.id/api/payments/midtrans/webhook
MIDTRANS_NOTIFY_URL=
