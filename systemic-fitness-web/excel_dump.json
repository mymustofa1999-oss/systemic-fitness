  [
    "SCORING REFERENCE"
  ],
  [],
  [
    "SYSTEMIC SCORE™",
    "Total = P1 + P2 + P3   (maximum 3.0)"
  ],
  [
    "P1 — Blood Pressure",
    "1.0 🟢 ΔSBP ≤ +15 AND ΔDBP ≤ +10  ·  0.5 🟡 ΔSBP +16-25 OR ΔDBP +11-15  ·  0 🔴 ΔSBP > +25 OR ΔDBP > +15"
  ],
  [
    "P2 — Heart Rate",
    "1.0 🟢 ΔHR ≤ 25 bpm  ·  0.5 🟡 ΔHR 26-40 bpm  ·  0 🔴 ΔHR > 40 bpm"
  ],
  [
    "P3 — Symptoms",
    "1.0 🟢 None  ·  0.5 🟡 symptom but session completed & resolved < 5 min  ·  0 🔴 session stopped or symptom > 5 min"
  ],
  [
    "SYSTEMIC STATUS",
    "3.0 🟢 Adaptive · 2.0-2.5 🟡 Acceptable · 1.0-1.5 🟠 Suboptimal · 0-0.5 🔴 Non-Adaptive"
  ],
  [
    "SAFETY OVERRIDE",
    "If Stopped = Yes, status becomes 🔴 Non-Adaptive regardless of total."
  ],
  [],
  [
    "SYSTEMIC DAILY HABIT",
    "Total = 4 parameters (maximum 4.0). Asked at the pre-session BP measurement."
  ],
  [
    "1 — Nutrition Readiness",
    "During the past 24 hours, did you consume any of the following? Tick ✓ each item consumed, or tick 'None of the above'."
  ],
  [
    "  checklist",
    "Sugary drinks (soft drinks, boba, sweet tea, sweet coffee) · Cakes, pastries, biscuits or desserts · Any food containing starch (meatball, noodles, bread, cassava, potatoes, corn, sweet potatoes, taro) · Large portions of rice, noodles, bread or refined carbohydrates · Butter, creamy foods or fatty meat · Organ meats · Seafood known to trigger your symptoms"
  ],
  [
    "  status",
    "1.0 🟢 Ready — no risk food  ·  0.5 🟡 Monitor — one risk food  ·  0 🔴 Needs Attention — two or more"
  ],
  [
    "2 — Hydration Readiness",
    "Approximately how much water have you consumed today?"
  ],
  [
    "  status",
    "1.0 🟢 Well Hydrated — more than 1.5 L  ·  0.5 🟡 Mildly Dehydrated — around 1-1.5 L  ·  0 🔴 Poor Hydration — less than 1 L"
  ],
  [
    "3 — Sleep Recovery",
    "How did you sleep last night?"
  ],
  [
    "  status",
    "1.0 🟢 Good Recovery — slept well and felt refreshed  ·  0.5 🟡 Monitor — woke up once or twice (urination)  ·  0 🔴 Poor Recovery — frequently woke up or had difficulty sleeping"
  ],
  [
    "4 — Daily Activity",
    "Before today's session, how active have you been?"
  ],
  [
    "  status",
    "1.0 🟢 Active — regular daily movement  ·  0.5 🟡 Low Activity — mostly sitting  ·  0 🔴 Sedentary — almost no movement today"
  ],
  [
    "LIFESTYLE STATUS",
    "4.0 🟢 Excellent Lifestyle — proceed with the planned programme"
  ],
  [
    null,
    "3.0-3.5 🟢 Good Lifestyle — proceed with routine monitoring"
  ],
  [
    null,
    "2.0-2.5 🟡 Moderate Lifestyle — monitor BP & HR closely, consider reducing intensity"
  ],
  [
    null,
    "below 2.0 🔴 Low Lifestyle — reassess before training, consider modifying the programme"
  ],
  [],
  [
    "NOTES COLUMNS",
    "Food Detail, Hydration Notes, Sleep Notes, Activity Notes, Symptom Notes and General Notes are free text and never affect the score."
  ],
  [
    "REVIEW CADENCE",
    "Systemic Score & Daily Habit → monthly (1 block = 8 sessions).  Level, medical condition & lab report → quarterly (3 blocks = 24 sessions)."
  ],
  [
    "HALF-POINT NOTE",
    "The original table lists 4 / 3 / 2 / 0-1 only. Because parameters score in 0.5 steps, totals of 3.5, 2.5 and 1.5 are possible; they band down (3.5→Good, 2.5→Moderate, 1.5→Low). Confirm if you want different cut-offs."
